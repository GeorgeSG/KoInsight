# ---------------------------------------------------------------------------
# KoInsight - frontend (Vite) environment
# ---------------------------------------------------------------------------
# Local development: copy this file to `apps/web/.env`
#   cp apps/web/.env.example apps/web/.env
# Only VITE_-prefixed variables are exposed to the app. All optional; the
# defaults below match the app's built-in defaults.
# VITE_WEB_PORT / VITE_WEB_HOSTNAME configure the dev server; VITE_WEB_API_URL
# is compiled into the build at build time.
# ---------------------------------------------------------------------------

# Port the Vite dev server listens on.
# Default: 3000  (proxies /api and /syncs to the backend on port 3001)
VITE_WEB_PORT=3000

# Host/interface for the Vite dev server.
# Default: localhost
VITE_WEB_HOSTNAME=localhost

# Base URL the frontend uses for API/server requests.
# Leave EMPTY for the standard single-origin setup (relative "/api"): in dev the
# Vite server proxies to the backend, and in production the backend serves both
# the app and the API from the same origin. Set an absolute URL only if the API
# is hosted on a separate origin.
VITE_WEB_API_URL=
